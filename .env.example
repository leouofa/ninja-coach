# LLM provider: "groq" (default) or "google"
AI_PROVIDER=groq

# Optional model override; falls back to the per-provider default in src/lib/ai.
# Groq default: openai/gpt-oss-120b / Google default: gemini-3.6-flash
# AI_MODEL=

# API key for the active provider is required.
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# SQLite database file location (used by src/lib/db).
DATABASE_PATH=
