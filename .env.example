# LLM provider: "google" (default) or "groq"
AI_PROVIDER=google

# Optional model override; falls back to the per-provider default in src/lib/ai.
# Google default: gemini-3.7-flash / Groq default: qwen/qwen3.8-27b
# AI_MODEL=

# API key for the active provider is required.
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Local embeddings model override; falls back to nomic-ai/nomic-embed-text-v1.5
# (used by src/lib/embeddings, cached under .cache/huggingface)
# EMBEDDINGS_MODEL=

# SQLite database file location (used by src/lib/db).
DATABASE_PATH=
